<div id="cardbox-overview">
    <div class="cardbox-filters">
        <span>{{#str}} topicfilter, cardbox {{/str}} </span>
        <span>
            <select id="cardbox-overview-topicfilter" class="custom-select">
                <option value="-1" {{#nopreference}}selected{{/nopreference}}>{{#str}} noselection, cardbox {{/str}}</option>
                {{#topics}}
                    <option value="{{topicid}}" {{#selected}}selected{{/selected}}>{{topic}}</option>
                {{/topics}}
                <option value="0" {{#cardswithouttopic}}selected{{/cardswithouttopic}}>{{# str }} notopic, cardbox {{/ str }}</option>
            </select>
        </span>
        <span>{{#str}} deckfilter, cardbox {{/str}} </span>
        <span>
            <select id="cardbox-overview-deckfilter" class="custom-select">
                <option value="-1" {{#nopreferencedeck}}selected{{/nopreferencedeck}}>{{#str}} noselection, cardbox {{/str}}</option>
                <option value="0" {{#newcard}}selected{{/newcard}}>{{#str}} new, cardbox {{/str}}</option>
                {{#decks}}
                    <option value="{{deck}}" {{#selected}}selected{{/selected}}>{{deck}}</option>
                {{/decks}}
                <option value="6" {{#masteredcard}}selected{{/masteredcard}}>{{#str}} known, cardbox {{/str}}</option>
            </select>
        </span>

        <span>{{#str}} sorting, cardbox {{/str}} </span>
        <span>
            <select id="cardbox-filter-options" class="custom-select">
                <option value="0">{{#str}} createddate, cardbox {{/str}} {{#str}} ascending, cardbox {{/str}}</option>
                <option value="1" {{#sortca}}selected{{/sortca}}>{{#str}} createddate, cardbox {{/str}} {{#str}} descending, cardbox {{/str}}</option>
                <option value="2" {{#sortad}}selected{{/sortad}}>{{#str}} alphabetical, cardbox {{/str}} {{#str}} ascending, cardbox {{/str}}</option>
                <option value="3" {{#sortaa}}selected{{/sortaa}}>{{#str}} alphabetical, cardbox {{/str}} {{#str}} descending, cardbox {{/str}}</option>
            </select>
        </span>
    </div>
    <div class="input-group cardbox-search">
        <input type="text" id="cardbox-search" class="form-control" placeholder="Search..." value="{{search}}">
        <div class="input-group-append">
            <button type="button" id="cardbox-search-btn" class="btn btn-secondary">
                <i class="fa fa-search"></i>
            </button>
        </div>
    </div>

    <div class="container-fluid cardbox-studyview">            

        {{#cards}}

            <div id="cardbox-card-in-overview" data-cardid="{{cardid}}" class="row overviewcontent" >  

                {{#allowedtoedit}}
{{!                     <div class="col-2"></div> }}
                    <div class="col-4 review-topic topic" >{{#str}}reviewtopic, cardbox{{/str}} {{topic}}</div>
                    <div class="col-4"> 
                        <div class="card-icon-grid-div"> 
                        {{^disableautocorrect}}
                        <div></div>
                        {{/disableautocorrect}} 
                        {{#disableautocorrect}}
                        <div><span class="badge bg-secondary" data-bs-toggle = "tooltip" data-bs-title = "{{#str}}autocorrecticon_help, cardbox, {{decktext}}{{/str}}">{{acimgurl}}</span></div>
                        {{/disableautocorrect}} 
                        <div class="common-margin">
                        {{#multipleanswers}}
                        {{#allansnecessary}}
                        <span class="badge bg-dark" data-bs-toggle = "tooltip" data-bs-title = "{{#str}}allanswersnecessary_help, cardbox, {{decktext}}{{/str}}">{{howmanyanswersnecessary}}</span>
                        {{/allansnecessary}}
                        {{^allansnecessary}}
                        <span class="badge bg-dark" data-bs-toggle = "tooltip" data-bs-title = "{{#str}}oneanswersnecessary_help, cardbox, {{decktext}}{{/str}}">{{howmanyanswersnecessary}}</span> 
                        {{/allansnecessary}}{{/multipleanswers}}</div>
                            <div class="rep-icon-grid-div common-margin" data-bs-toggle = "tooltip" data-bs-title = "{{#str}}manager:repeatdesc, cardbox, {{repsnummer}}{{/str}}">
                            {{#reps}}<img src="https://img.icons8.com/ios-glyphs/30/000000/repeat.png"/> {{repsnummer}}{{/reps}}</div>
                            <div class="common-margin"><img src={{deckimgurl}} alt="This card belongs to Deck {{deck}}" class="cardbox_card_deck_icon" 
                            data-bs-toggle = "tooltip" data-bs-title = "{{#str}}manager:deckdescription, cardbox, {{decktext}}{{/str}}"></div>
                        </div>
                    </div>
                    <div class="col-2"></div> 
                {{/allowedtoedit}}

                {{^allowedtoedit}}
                    <div class="col-2"></div>
                    <div class="col-4">{{#str}}reviewtopic, cardbox{{/str}} {{topic}}</div>
                    <div class="col-4"> 
                        <div class="card-icon-grid-div"> <div class="common-margin">
                        {{#multipleanswers}} 
                           {{#allansnecessary}}
                        <span class="badge bg-dark" data-bs-toggle = "tooltip" data-bs-title = "{{#str}}allanswersnecessary_help, cardbox, {{decktext}}{{/str}}">{{howmanyanswersnecessary}}</span>
                        {{/allansnecessary}}
                        {{^allansnecessary}}
                        <span class="badge bg-dark" data-bs-toggle = "tooltip" data-bs-title = "{{#str}}oneanswersnecessary_help, cardbox, {{decktext}}{{/str}}">{{howmanyanswersnecessary}}</span> 
                        {{/allansnecessary}}
                        {{/multipleanswers}}</div>
                            <div class="rep-icon-grid-div common-margin" data-bs-toggle = "tooltip" data-bs-title = "{{#str}}student:repeatdesc, cardbox, {{repsnummer}}{{/str}}">
                            {{#reps}}<img src="https://img.icons8.com/ios-glyphs/30/000000/repeat.png"/> {{repsnummer}}{{/reps}}
                            </div>
                            {{^disableautocorrect}}
                        <div></div>
                        {{/disableautocorrect}} 
                        {{#disableautocorrect}}
                        <div><span class="badge bg-secondary" data-bs-toggle = "tooltip" data-bs-title = "{{#str}}autocorrecticon_help, cardbox, {{decktext}}{{/str}}">{{acimgurl}}</span></div>
                        {{/disableautocorrect}}
                            <div class="common-margin"><img src={{deckimgurl}} alt="This card belongs to Deck {{deck}}" class="cardbox_card_deck_icon" 
                            data-bs-toggle = "tooltip" data-bs-title = "{{#str}}student:deckdescription, cardbox, {{decktext}}{{/str}}"></div>
                        </div>
                    </div>
                    <div class="col-2"></div> 
                {{/allowedtoedit}}

                <div class="col-4 ques-teil"><div class="cardbox-column">
                    
                        <div class="cardbox-card-left-side">
                            <div class="cardbox-cardside">
                                <div>
                                {{#question}}
                                    {{> mod_cardbox/cardside }}
                                {{/question}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{#ismobile}}
                    <div class="col-4">
                        <div class="cardbox-column" >{{{questioncontext}}}</div>
                </div>
                {{/ismobile}}

                <div class="col-4 ans-teil">
                    <div class="cardbox-column">
                        {{#multipleanswers}}
                        {{#answer}}
                        <div>
                            <div class="cardbox-card-right-side-multi">
                            {{#texts}}
                                <div class="cardbox-cardside-multi">
                                    <div class="cardbox-card-text">{{{text}}}</div>
                                </div>
                            {{/texts}}
                            </div>
                        </div>
                        {{/answer}}
                        {{/multipleanswers}}
                        {{^multipleanswers}}
                        <div class="cardbox-card-right-side">
                            <div>
                                <div class="cardbox-cardside">
                                    {{#answer}}
                                        {{> mod_cardbox/cardside }}
                                    {{/answer}}
                                </div>
                            </div>
                        </div>
                        {{/multipleanswers}}
                    </div>
                </div>
                {{#ismobile}}
                    <div class="col-4" >
                        <div class="cardbox-column" >{{{answercontext}}}</div>
                    </div>
                {{/ismobile}}
                {{#allowedtoedit}}

                <div class="col-auto">
                    <div id="review-button-wrapper">
                    {{#ismobile}}
                        <div class="btn-group" role="group" aria-label="review-actions">
                    {{/ismobile}}
                    {{^ismobile}}
                        <div class="btn-group-vertical" role="group" aria-label="review-actions">
                    {{/ismobile}}
                            <button id="cardbox-edit-{{cardid}}" type="button" class="btn btn-primary cardbox-overview-button-edit"  data-bs-toggle = "tooltip" data-bs-title={{# str }} edit, cardbox {{/ str }}><i class="icon fa fa-pencil fa-fw"></i></button>
                            <button id="cardbox-delete-{{cardid}}" type="button" class="btn btn-primary cardbox-delete-button cardbox-overview-button-delete" data-bs-toggle = "tooltip" data-bs-title="{{# str }} delete, cardbox {{/ str }}"><i class="icon fa fa-trash fa-fw"></i></button>
                        </div>
                    </div>
                </div>

            </div>
            {{^ismobile}}
            <div id="cardbox-card-in-overview" class="row overviewcontent" style="display: flex; margin-top: 10px">
                <div class="offset-4 col-4">
                    <div class="cardbox-column" >{{{questioncontext}}}</div>
                </div>
                <div class="col-4">
                    <div class="cardbox-column" >
                        <div>{{{answercontext}}}</div>
                    </div>
                </div>
            </div>
            {{/ismobile}}
            {{/allowedtoedit}}
            
            {{^allowedtoedit}}
            </div>
            <div id="cardbox-card-in-overview" class="row overviewcontent" style="display: flex; margin-top: 10px">
                <div class="col-2"></div>
                <div class="col-4">{{{questioncontext}}}</div>
                <div class="col-4">{{{answercontext}}}</div>
                <div class="col-2"></div> 
            </div> 
            {{/allowedtoedit}}
        {{/cards}}    
    </div>
</div>