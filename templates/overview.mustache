<div id="cardbox-overview">

    <span>Themenfilter </span><span><select id="cardbox-overview-topicfilter" class="custom-select">
        <option value="-1" {{#nopreference}}selected{{/nopreference}}>keine Auswahl</option>
        {{#topics}}
            <option value="{{topicid}}" {{#selected}}selected{{/selected}}>{{topic}}</option>
        {{/topics}}
        <option value="0" {{#cardswithouttopic}}selected{{/cardswithouttopic}}>{{# str }} notopic, cardbox {{/ str }}</option>
    </select></span>

    {{#cards}}

        {{#color}}
        <div class="container-fluid cardbox-studyview">
        {{/color}}

        {{^color}}
        <div class="container-fluid cardbox-studyview" style="background-color: lightgrey">
        {{/color}}

{{!             <h5>{{# str}} {{! reviewtopic, cardbox {{/ str }}{{! <em>{{topic}}{{! </em></h5> }}
            

            <div id="cardbox-card-in-overview-{{cardid}}" data-cardid="{{cardid}}" class="row reviewcontent">

                <div class="row reviewcontent">
                    <p class="col-lg-1 col-xl-2" >{{# str }} reviewtopic, cardbox {{/ str }}</p>
                        <p class="cardbox-context-overview">{{topic}}</p>
                    <div class="hidden-xs col-lg-1 col-xl-2"></div>
                </div>                

                <div class="hidden-xs col-lg-1 col-xl-2">{{# str }} card, cardbox {{/ str }}</div>
                <div class="col-xs-12 col-sm-6 col-lg-5 col-xl-4 cardbox-column">
                    <div class="cardbox-card-left-side">
                        {{#question}}
                            {{> mod_cardbox/cardside }}
                        {{/question}}
                    </div>
                </div>
                <div class="col-xs-12 col-sm-6 col-lg-5 col-xl-4 cardbox-column">
                    <div class="cardbox-card-right-side">
                        {{#answer}}
                            {{> mod_cardbox/cardside }}
                        {{/answer}}
                    </div>
                </div>
                <div class="hidden-xs col-lg-1 col-xl-2">
                    {{#allowedtoedit}}
                        <form action="view.php" method="post" autocomplete="off">
                            <input type="hidden" name="id" value="{{cmid}}">
                            <input type="hidden" name="action" value="editcard">
                            <input type="hidden" name="from" value="overview">
                            <input type="hidden" name="cardid" value="{{cardid}}">
                            <button id="cardbox-overview-edit" type="submit" class="btn btn-primary cardbox-review-button" title="{{# str }} edit, cardbox {{/ str }}"><i class='icon fa fa-pencil fa-fw'></i></button>
                        </form>
                        <button id="cardbox-delete-{{cardid}}" type="submit" class="btn btn-primary cardbox-delete-button cardbox-review-button" title="{{# str }} edit, cardbox {{/ str }}"><i class='icon fa fa-trash fa-fw'></i></button>
                        
                    {{/allowedtoedit}}
                </div>
                <br>

                {{#contextquestionavailable}}
                <div class="row reviewcontent">

                    <div class="col-lg-1 col-xl-2">{{# str }} addtionalinformation, cardbox {{/ str }}</div>
                    <div class="col-xs-12 col-sm-6 col-lg-5 col-xl-4 cardbox-column">
                        <div>
                            <div class='cardbox-context-overview' style="padding-right: 15px">{{{questioncontext}}}</div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-6 col-lg-5 col-xl-4 cardbox-column">
                        <div>
                            {{#contextansweravailable}}
                                <div class='cardbox-context-overview' style="padding-left: 25px">{{{answercontext}}}</div>
                            {{/contextansweravailable}}
                        </div>
                    </div>
                    <div class="col-lg-1 col-xl-2"></div>
                </div>

                {{/contextquestionavailable}}

                {{^contextquestionavailable}}
                {{#contextansweravailable}}

                <div class="row reviewcontent">

                    <div class="col-lg-1 col-xl-2">{{# str }} addtionalinformation, cardbox {{/ str }}</div>
                    <div class="col-xs-12 col-sm-6 col-lg-5 col-xl-4 cardbox-column">

                            <div class='cardbox-context-overview'></div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-lg-5 col-xl-4 cardbox-column">

                            <div class='cardbox-context-overview' style="padding-left: 25px">{{{answercontext}}}</div>

                    </div>
                    <div class="col-lg-1 col-xl-2"></div>
                </div>

                {{/contextansweravailable}}
                {{/contextquestionavailable}}

                {{#seestatus}}
                <div class="row reviewcontent">

                    <div class="col-lg-1 col-xl-2">{{# str }} cardposition, cardbox {{/ str }} {{{helpicon}}}</div>
                    <div class="col-xs-12 col-sm-6 col-lg-5 col-xl-4 cardbox-column">

                            <div class='cardbox-context-overview'>{{status}}</div>

                    </div>
                    <div class="col-xs-12 col-sm-6 col-lg-5 col-xl-4 cardbox-column">

                            <div class='cardbox-context-overview' style="padding-left: 25px"></div>

                    </div>
                    <div class="col-lg-1 col-xl-2"></div>
                </div>
                {{/seestatus}}
                
            </div>
            
        </div>
{{!         <hr style="background-color:Black; height: 0,5px">}}
    {{/cards}}

</div>
