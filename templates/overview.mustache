<div id="cardbox-overview">

    <span>{{#str}} topicfilter, cardbox {{/str}} </span><span><select id="cardbox-overview-topicfilter" class="custom-select">
        <option value="-1" {{#nopreference}}selected{{/nopreference}}>{{#str}} noselection, cardbox {{/str}}</option>
        {{#topics}}
            <option value="{{topicid}}" {{#selected}}selected{{/selected}}>{{topic}}</option>
        {{/topics}}
        <option value="0" {{#cardswithouttopic}}selected{{/cardswithouttopic}}>{{# str }} notopic, cardbox {{/ str }}</option>
    </select></span>

    <div class="container-fluid cardbox-studyview">            

        {{#cards}}

            <div id="cardbox-card-in-overview" data-cardid="{{cardid}}" class="row overviewcontent" style="margin-bottom: 0px;">

                <div class="topic-overview" style="margin-left: 16%">{{#str}}reviewtopic, cardbox{{/str}} {{topic}}</div>
                <div class="col-xl-4" style="padding:0px;"><div class="cardbox-column" style="height: 100%;">
                    <div class="cardbox-card-left-side">
                            <div class="cardbox-cardside">
                                <div style="height:100%">
                                {{#question}}
                                    {{> mod_cardbox/cardside }}
                                {{/question}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4" style="padding:0px;">
                    <div class="cardbox-column" style="height: 100%;">
                        <div class="cardbox-card-right-side">
                            <div>
                                {{! {{#multipleanswers}}
                                {{!    {{#answer}}
                                {{!        <div class="cardbox-card-right-side-multi">
                                            <div class="cardbox-cardside-multi">
                                                {{> mod_cardbox/cardside }}
                                {{!           </div>
                                        </div>
                                    {{/answer}}
                                {{!{{/multipleanswers}}
                                

                                {{!{{^multipleanswers}}
                                    <div class="cardbox-cardside">
                                        {{#answer}}
                                            {{> mod_cardbox/cardside }}
                                        {{/answer}}
                                    </div>
                                {{!{{/multipleanswers}}
                            </div>
                        </div>
                    </div>
                </div>

                {{#allowedtoedit}}

                <div class="col-xs-2">
                    <div id="review-button-wrapper">
                        <div class="btn-group-vertical" role="group" aria-label="review-actions">
                            <button id="cardbox-edit-{{cardid}}" type="button" class="btn btn-primary cardbox-overview-button-edit" title="Edit"><i class="icon fa fa-pencil fa-fw"></i></button>
                            <button id="cardbox-delete-{{cardid}}" type="button" class="btn btn-primary cardbox-delete-button cardbox-overview-button-delete" title="'.get_string('edit', 'cardbox').'"><i class="icon fa fa-trash fa-fw"></i></button>
                        </div>
                    </div>
                </div>

                {{/allowedtoedit}}
            
            </div>

            <div id="cardbox-card-in-review" data-cardid="'.$cardid.'-contextfelder" class="row reviewcontent" style="display: -webkit-box; margin-top: 10px">
                <div class="col-xl-4" style="margin-left: 15%; padding-right: 0px; padding-left: 1%;">
                    <div class="cardbox-column" >{{{questioncontext}}}</div>
                </div>
                <div class="col-xl-4" style="padding-left:0.5%;">
                    <div class="cardbox-column" >
                        <div>{{{answercontext}}}</div>
                    </div>
                </div>
            </div>

        {{/cards}}
    
    </div>

</div>
