<div class="container-fluid cardbox-studyview">

    <div class="row">
        <div class="col-sm-2" style="background-color:blue;"></div>
        <div id="cardbox-cardcontainer" class="col-sm-8">
            {{> mod_cardbox/card }}
        </div>
        <div class="col-sm-2" style="background-color:blue;"></div>
    </div>
    <div class="row">
        <div class="col-sm-2" style="background-color:orange;"></div>
